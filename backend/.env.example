# Copy this file to `.env` in this folder before running the API locally.
# `player_data` is not in git — you extract or copy it onto your machine, then point
# PLAYER_DATA_PATH at that folder (absolute path or relative to backend/).
#
# Windows example:
# PLAYER_DATA_PATH=C:\Users\you\Documents\player_data
#
# macOS / Linux example:
# PLAYER_DATA_PATH=/home/you/data/player_data

PLAYER_DATA_PATH=../player_data
